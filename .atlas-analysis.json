  "keyFeatures": [
    "Frictionless quick-capture — no folders required before saving a thought",
    "End-to-end encrypted vault using AES-256-GCM with dual-wrap DEK",
    "Email capture via a personal send-to address (you@sendto.tuckthis.app)",
    "Tags and Brains for post-capture organization",
    "Full rich-text editor for expanding on captured thoughts",
    "Reminders that fire even when no browser tab is open",
    "Opt-in share links — publish a single tuck as a readable URL",
    "Cross-device sync over ciphertext (never plaintext)",
    "Native iOS/iPadOS app with Face ID and share-sheet capture",
    "Local-first architecture — vault passphrase never leaves the device"
  ],
  "publicApiSurface": [
    "Email capture: you@sendto.tuckthis.app inbound address",
    "Share link: published snapshot URL for a single tuck",
    "Vault unlock: passphrase-based PBKDF2 key derivation (client-side only)",
    "Recovery kit: second AES-256-GCM wrap of the DEK for disaster recovery",
    "iOS share sheet: pending capture write path",
    "iOS widgets: pending capture write path"
